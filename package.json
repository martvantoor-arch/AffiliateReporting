{
  "name": "affiliate-reporting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-prisma.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "setup": "node scripts/generate-prisma.mjs && prisma db push",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "demo": "tsx prisma/demo.ts",
    "d1:migration": "prisma migrate diff --from-local-d1 --to-schema prisma/schema.prisma --script",
    "d1:apply:local": "wrangler d1 migrations apply kasboek --local",
    "d1:apply": "wrangler d1 migrations apply kasboek --remote",
    "cf:build": "node scripts/generate-prisma.mjs workerd && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "generate": "node scripts/generate-prisma.mjs"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/adapter-d1": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "fast-xml-parser": "^5.10.1",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
