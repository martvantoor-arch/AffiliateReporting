# Kopieer dit bestand naar .env en vul de waarden aan.
# Genereer geheimen met:  openssl rand -hex 32

# --- Database -------------------------------------------------------
# SQLite: één bestand. Het pad wordt gerekend vanaf de map waar je de app start
# (de projectmap), niet vanaf prisma/. Zorg dat het op een schijf staat die
# bewaard blijft — bij een container dus een volume.
DATABASE_URL="file:./prisma/kasboek.db"

# --- Geheimen (verplicht) -------------------------------------------
# Versleutelt de API-sleutels van je netwerken in de database.
# LET OP: verlies je deze sleutel, dan zijn de opgeslagen credentials
# onleesbaar en moet je ze opnieuw invoeren.
ENCRYPTION_KEY=""

# Ondertekent sessiecookies. Wijzig je deze, dan is iedereen uitgelogd.
SESSION_SECRET=""

# --- Automatisch ophalen (optioneel) --------------------------------
# Minimaal 16 tekens. Zonder deze waarde is /api/cron/sync uitgeschakeld.
# Voorbeeld crontab, elk uur:
#   0 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://jouw-app/api/cron/sync
CRON_SECRET=""

# --- Accounts (optioneel) -------------------------------------------
# Leeg = alleen de eerste registratie is toegestaan, daarna gaat de deur dicht.
# Wil je later nog een account kunnen aanmaken, zet dan hier de toegestane
# e-mailadressen, gescheiden door komma's.
ALLOWED_SIGNUP_EMAILS=""

# Tijdzone waarin transacties op dagen worden ingedeeld.
APP_TIMEZONE="Europe/Amsterdam"
