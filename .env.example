# Kopieer dit bestand naar .env en vul de waarden aan.
# Genereer geheimen met:  openssl rand -hex 32

# --- Database -------------------------------------------------------
# SQLite: één bestand. Het pad wordt gerekend vanaf de map waar je de app start
# (de projectmap), niet vanaf prisma/. Zorg dat het op een schijf staat die
# bewaard blijft — bij een container dus een volume.
DATABASE_URL="file:./prisma/kasboek.db"

# --- Geheimen (verplicht) -------------------------------------------
# Versleutelt de API-sleutels van je netwerken in de database.
# LET OP: verlies je deze sleutel, dan zijn de opgeslagen credentials
# onleesbaar en moet je ze opnieuw invoeren.
ENCRYPTION_KEY=""

# Ondertekent sessiecookies. Wijzig je deze, dan is iedereen uitgelogd.
SESSION_SECRET=""

# --- Automatisch ophalen --------------------------------------------
# De app haalt in productie zelf elk half uur je cijfers op. Hier kun je dat
# interval in minuten aanpassen; 0 zet het uit. Minimum is 15 minuten — sneller
# heeft geen zin, want de netwerken werken niet vaker bij.
# Dit bepaalt ook hoe snel je een melding krijgt bij een nieuwe sale.
# Let op: dit werkt omdat de app als één proces draait. Zet je meerdere
# instanties op, zet dit dan op 0 en gebruik de cron hieronder.
AUTO_SYNC_MINUTES="30"

# Alleen nodig als je /api/cron/sync van buitenaf wilt aanroepen in plaats van
# de ingebouwde planner. Minimaal 16 tekens; zonder deze waarde is het endpoint
# uitgeschakeld. Voorbeeld crontab, elk uur:
#   0 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://jouw-app/api/cron/sync
CRON_SECRET=""

# --- Notificaties (optioneel) ---------------------------------------
# Voor een melding op je telefoon bij een nieuwe sale. Genereer het sleutelpaar
# met:  npm run vapid
# Zonder deze waarden werkt de app gewoon, alleen zonder meldingen.
# Let op: vervang je de sleutels, dan moet je op elk apparaat opnieuw
# toestemming geven.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contactadres voor Apple en Google; moet met mailto: of https: beginnen.
VAPID_SUBJECT="mailto:jij@voorbeeld.nl"

# --- Accounts (optioneel) -------------------------------------------
# Leeg = alleen de eerste registratie is toegestaan, daarna gaat de deur dicht.
# Wil je later nog een account kunnen aanmaken, zet dan hier de toegestane
# e-mailadressen, gescheiden door komma's.
ALLOWED_SIGNUP_EMAILS=""

# Tijdzone waarin transacties op dagen worden ingedeeld.
APP_TIMEZONE="Europe/Amsterdam"
